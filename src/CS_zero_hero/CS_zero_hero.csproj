<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Every topic file has its own Main(): Program.cs is the one entry point and runs a topic by name -->
    <StartupObject>CS_Zero_Hero.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lesson classes are internal: let the test project (CS_zero_heroTests) see them -->
    <InternalsVisibleTo Include="CS_zero_heroTests" />
  </ItemGroup>

</Project>
