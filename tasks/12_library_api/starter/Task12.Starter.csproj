<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Microsoft.NET.Sdk.Web brings in ASP.NET Core, which ships with the .NET SDK: no NuGet packages -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LibraryManager</RootNamespace>
    <!-- The web SDK runs the program in the project folder. Run it in the current folder instead, like
         the other tasks, so tasks/data is found from the repo root. -->
    <EnableDefaultRunWorkingDirectory>false</EnableDefaultRunWorkingDirectory>
  </PropertyGroup>

</Project>
